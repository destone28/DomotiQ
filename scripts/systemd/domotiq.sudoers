# The staff page of the web app can reboot or power off the board and change the hotspot password;
# scripts/release.sh restarts the services after copying new code.
arduino ALL=(root) NOPASSWD: /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff, /usr/bin/systemctl restart domotiq, /usr/bin/systemctl restart domotiq-tts, /usr/bin/systemctl restart domotiq-llm, /usr/bin/nmcli connection modify domotiq-hotspot *, /usr/bin/nmcli connection up domotiq-hotspot
