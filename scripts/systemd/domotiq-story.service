# The storyteller: a second llama-server with a model that writes stories and free answers.
# Separate from domotiq-llm (commands) so that each keeps its own cache. models/llm/story.gguf
# is a link to the model chosen by scripts/install.sh. Two slots: one for the requests of the
# visitors (it keeps the memory of the house read), one for the stories written ahead.
[Unit]
Description=DomotiQ storyteller model (llama.cpp)
After=network.target domotiq-llm.service

[Service]
# the storyteller writes on cores 2-3 while the synthesis speaks on cores 0-1: sharing all four,
# each slowed the other down to a sentence every 15 seconds
CPUAffinity=2 3
Type=simple
User=arduino
Group=arduino
WorkingDirectory=/home/arduino/domotiq
ExecStart=/home/arduino/domotiq/llama.cpp/build/bin/llama-server -m /home/arduino/domotiq/models/llm/story.gguf --host 127.0.0.1 --port 8082 -c 4096 -t 2 -np 2 --reasoning-budget 0
Nice=10
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
