# llama-server with Qwen2.5-0.5B-Instruct, loopback only, lower priority than vision and voice. Four slots
# of 2048 tokens: the commands of the house, the answers to "who is it?", the answers to offers and the topics
# of the questions about the characters, each keeping its instructions in its cache. Once read, the slots are
# saved in /var/lib/domotiq-llm and put back at the next start in a moment, instead of ten minutes of reading.
[Unit]
Description=DomotiQ language model (llama.cpp)
After=network.target

[Service]
Type=simple
User=arduino
Group=arduino
WorkingDirectory=/home/arduino/domotiq
ExecStart=/home/arduino/domotiq/llama.cpp/build/bin/llama-server -m /home/arduino/domotiq/models/llm/qwen2.5-0.5b-instruct-q4_k_m.gguf --host 127.0.0.1 --port 8081 -c 8192 -t 3 -np 4 --slot-save-path /var/lib/domotiq-llm
Nice=10
# last under load (see domotiq.service): it reads its instructions in the background
CPUWeight=50
StateDirectory=domotiq-llm
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
