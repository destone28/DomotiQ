[Unit]
Description=DomotiQ smart home (vision, rules, voice, web app)
After=network-online.target arduino-router.service domotiq-tts.service
Wants=network-online.target domotiq-tts.service

[Service]
Type=simple
User=arduino
Group=arduino
SupplementaryGroups=audio video dialout gpiod
WorkingDirectory=/home/arduino/domotiq
Environment=PYTHONPATH=/home/arduino/domotiq/src
Environment=PYTHONUNBUFFERED=1
Environment=DOMOTIQ_PORT=80
ExecStart=/home/arduino/domotiq/venv/bin/python -m domotiq
Restart=always
RestartSec=2
# port 80 and setting the clock from a phone, nothing else
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_TIME
ProtectSystem=full
PrivateTmp=yes
TimeoutStopSec=10
# SIGTERM to the application only: it stops its vision process itself, the rest is killed after
KillMode=mixed

[Install]
WantedBy=multi-user.target
