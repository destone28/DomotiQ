+}
+
+// The four sums of products of two Q6_K rows by two Q8_K columns, one super-block, added to out as
+// [x0.y0, x1.y0, x0.y1, x1.y1]: every weight is unpacked once and used for both columns.
+static inline void ggml_nodot_q6_K_2x2_block(const block_q6_K * GGML_RESTRICT x0, const block_q6_K * GGML_RESTRICT x1,
+                                             const block_q8_K * GGML_RESTRICT y0, const block_q8_K * GGML_RESTRICT y1,
+                                             float32x4_t * GGML_RESTRICT out) {
+    // the offset -32 of the weights through the sums of the q8 (row r, column c)
+    const int8x16_t sca = vld1q_s8(x0->scales), scb = vld1q_s8(x1->scales);
+    const int16x8_t a0 = vmovl_s8(vget_low_s8(sca)), a1 = vmovl_high_s8(sca);
+    const int16x8_t b0 = vmovl_s8(vget_low_s8(scb)), b1 = vmovl_high_s8(scb);
+    const ggml_int16x8x2_t u = ggml_vld1q_s16_x2(y0->bsums), v = ggml_vld1q_s16_x2(y1->bsums);
+    int32x4_t m00 = vmull_s16(vget_low_s16(u.val[0]), vget_low_s16(a0)), m10 = vmull_s16(vget_low_s16(u.val[0]), vget_low_s16(b0));
+    int32x4_t m01 = vmull_s16(vget_low_s16(v.val[0]), vget_low_s16(a0)), m11 = vmull_s16(vget_low_s16(v.val[0]), vget_low_s16(b0));
+    m00 = vmlal_high_s16(m00, u.val[0], a0); m10 = vmlal_high_s16(m10, u.val[0], b0);
+    m01 = vmlal_high_s16(m01, v.val[0], a0); m11 = vmlal_high_s16(m11, v.val[0], b0);
+    m00 = vmlal_s16(m00, vget_low_s16(u.val[1]), vget_low_s16(a1)); m10 = vmlal_s16(m10, vget_low_s16(u.val[1]), vget_low_s16(b1));
+    m01 = vmlal_s16(m01, vget_low_s16(v.val[1]), vget_low_s16(a1)); m11 = vmlal_s16(m11, vget_low_s16(v.val[1]), vget_low_s16(b1));
+    m00 = vmlal_high_s16(m00, u.val[1], a1); m10 = vmlal_high_s16(m10, u.val[1], b1);
+    m01 = vmlal_high_s16(m01, v.val[1], a1); m11 = vmlal_high_s16(m11, v.val[1], b1);
+
+    int32x4_t c00 = vdupq_n_s32(0), c10 = c00, c01 = c00, c11 = c00;
+    for (int j = 0; j < QK_K/128; ++j) {
+        for (int hi = 0; hi < 2; ++hi) {
+            int8x16_t w0[4], w1[4];
+            ggml_nodot_q6_K_groups(x0->ql + 64*j, x0->qh + 32*j, hi, w0);
+            ggml_nodot_q6_K_groups(x1->ql + 64*j, x1->qh + 32*j, hi, w1);
+            const int8_t * GGML_RESTRICT s0 = x0->scales + 8*j + 4*hi;
+            const int8_t * GGML_RESTRICT s1 = x1->scales + 8*j + 4*hi;
+            const int8_t * GGML_RESTRICT p0 = y0->qs + 128*j + 64*hi;
+            const int8_t * GGML_RESTRICT p1 = y1->qs + 128*j + 64*hi;
+            for (int k = 0; k < 4; ++k) {
+                const int8x16_t q0 = vld1q_s8(p0 + 16*k), q1 = vld1q_s8(p1 + 16*k);
+                c00 = ggml_nodot_dot16_scaled(c00, w0[k], q0, s0[k]);
+                c10 = ggml_nodot_dot16_scaled(c10, w1[k], q0, s1[k]);
+                c01 = ggml_nodot_dot16_scaled(c01, w0[k], q1, s0[k]);
+                c11 = ggml_nodot_dot16_scaled(c11, w1[k], q1, s1[k]);
+            }
+        }
+    }
+    const float d0 = GGML_CPU_FP16_TO_FP32(x0->d), d1 = GGML_CPU_FP16_TO_FP32(x1->d);
+    const int32x4_t isum = vpaddq_s32(vpaddq_s32(c00, c10), vpaddq_s32(c01, c11));
+    const int32x4_t imin = vpaddq_s32(vpaddq_s32(m00, m10), vpaddq_s32(m01, m11));
+    const float32x4_t dd = { d0 * y0->d, d1 * y0->d, d0 * y1->d, d1 * y1->d };
+    *out = vfmaq_f32(*out, vcvtq_f32_s32(vmlsq_s32(isum, vdupq_n_s32(32), imin)), dd);
+}
+
+static void ggml_nodot_vec_dot_q6_K_q8_K_2x2(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,
+                                             size_t bx, const void * GGML_RESTRICT vy, size_t by) {
+    const int nb = n / QK_K;
+    const block_q6_K * GGML_RESTRICT x0 = (const block_q6_K *) vx;
+    const block_q6_K * GGML_RESTRICT x1 = (const block_q6_K *) ((const uint8_t *) vx + bx);
+    const block_q8_K * GGML_RESTRICT y0 = (const block_q8_K *) vy;
+    const block_q8_K * GGML_RESTRICT y1 = (const block_q8_K *) ((const uint8_t *) vy + by);
+    float32x4_t r = vdupq_n_f32(0.0f);
+    for (int i = 0; i < nb; ++i) {
+        ggml_nodot_q6_K_2x2_block(&x0[i], &x1[i], &y0[i], &y1[i], &r);
+    }
+    vst1_f32(s,      vget_low_f32(r));
+    vst1_f32(s + bs, vget_high_f32(r));
+}
+
+// The four sums of products of two Q4_K rows by two Q8_K columns, one super-block.
+static inline void ggml_nodot_q4_K_scales(const block_q4_K * GGML_RESTRICT x, uint32_t utmp[4], int16x8_t * mins) {
+    static const uint32_t kmask1 = 0x3f3f3f3f;
+    static const uint32_t kmask2 = 0x0f0f0f0f;
+    static const uint32_t kmask3 = 0x03030303;
+    memcpy(utmp, x->scales, 12);
+    uint32x2_t mins8 = { 0 };
+    mins8 = vset_lane_u32(utmp[1] & kmask1, mins8, 0);
+    mins8 = vset_lane_u32(((utmp[2] >> 4) & kmask2) | (((utmp[1] >> 6) & kmask3) << 4), mins8, 1);
+    utmp[1] = (utmp[2] & kmask2) | (((utmp[0] >> 6) & kmask3) << 4);
+    utmp[0] &= kmask1;
+    *mins = vreinterpretq_s16_u16(vmovl_u8(vreinterpret_u8_u32(mins8)));
+}
+
+static void ggml_nodot_vec_dot_q4_K_q8_K_2x2(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,
+                                             size_t bx, const void * GGML_RESTRICT vy, size_t by) {
+    const int nb = n / QK_K;
+    const block_q4_K * GGML_RESTRICT x0 = (const block_q4_K *) vx;
+    const block_q4_K * GGML_RESTRICT x1 = (const block_q4_K *) ((const uint8_t *) vx + bx);
+    const block_q8_K * GGML_RESTRICT y0 = (const block_q8_K *) vy;
+    const block_q8_K * GGML_RESTRICT y1 = (const block_q8_K *) ((const uint8_t *) vy + by);
+    const uint8x16_t m4b = vdupq_n_u8(0xf);
+    float32x4_t r = vdupq_n_f32(0.0f);
+    uint32_t ua[4], ub[4];
+    for (int i = 0; i < nb; ++i) {
+        int16x8_t mina, minb;
+        ggml_nodot_q4_K_scales(&x0[i], ua, &mina);
+        ggml_nodot_q4_K_scales(&x1[i], ub, &minb);
+        const int16x8_t u = vpaddq_s16(vld1q_s16(y0[i].bsums), vld1q_s16(y0[i].bsums + 8));
+        const int16x8_t v = vpaddq_s16(vld1q_s16(y1[i].bsums), vld1q_s16(y1[i].bsums + 8));
+        const int32x4_t m00 = vmlal_high_s16(vmull_s16(vget_low_s16(u), vget_low_s16(mina)), u, mina);
+        const int32x4_t m10 = vmlal_high_s16(vmull_s16(vget_low_s16(u), vget_low_s16(minb)), u, minb);
+        const int32x4_t m01 = vmlal_high_s16(vmull_s16(vget_low_s16(v), vget_low_s16(mina)), v, mina);
+        const int32x4_t m11 = vmlal_high_s16(vmull_s16(vget_low_s16(v), vget_low_s16(minb)), v, minb);
+
+        const uint8_t * GGML_RESTRICT sa = (const uint8_t *) ua, * GGML_RESTRICT sb = (const uint8_t *) ub;
+        const uint8_t * GGML_RESTRICT q40 = x0[i].qs, * GGML_RESTRICT q41 = x1[i].qs;
+        const int8_t  * GGML_RESTRICT p0 = y0[i].qs, * GGML_RESTRICT p1 = y1[i].qs;
+        int32x4_t c00 = vdupq_n_s32(0), c10 = c00, c01 = c00, c11 = c00;
+        for (int j = 0; j < QK_K/64; ++j) {
+            const ggml_uint8x16x2_t w0 = ggml_vld1q_u8_x2(q40 + 32*j), w1 = ggml_vld1q_u8_x2(q41 + 32*j);
+            const ggml_int8x16x4_t  b0 = ggml_vld1q_s8_x4(p0 + 64*j),  b1 = ggml_vld1q_s8_x4(p1 + 64*j);
+            const int8x16_t a0l = vreinterpretq_s8_u8(vandq_u8(w0.val[0], m4b)), a0m = vreinterpretq_s8_u8(vandq_u8(w0.val[1], m4b));
+            const int8x16_t a1l = vreinterpretq_s8_u8(vandq_u8(w1.val[0], m4b)), a1m = vreinterpretq_s8_u8(vandq_u8(w1.val[1], m4b));
+            c00 = ggml_nodot_dot32_scaled(c00, a0l, a0m, b0.val[0], b0.val[1], sa[2*j]);
+            c10 = ggml_nodot_dot32_scaled(c10, a1l, a1m, b0.val[0], b0.val[1], sb[2*j]);
+            c01 = ggml_nodot_dot32_scaled(c01, a0l, a0m, b1.val[0], b1.val[1], sa[2*j]);
+            c11 = ggml_nodot_dot32_scaled(c11, a1l, a1m, b1.val[0], b1.val[1], sb[2*j]);
+            const int8x16_t h0l = vreinterpretq_s8_u8(vshrq_n_u8(w0.val[0], 4)), h0m = vreinterpretq_s8_u8(vshrq_n_u8(w0.val[1], 4));
+            const int8x16_t h1l = vreinterpretq_s8_u8(vshrq_n_u8(w1.val[0], 4)), h1m = vreinterpretq_s8_u8(vshrq_n_u8(w1.val[1], 4));
+            c00 = ggml_nodot_dot32_scaled(c00, h0l, h0m, b0.val[2], b0.val[3], sa[2*j + 1]);
+            c10 = ggml_nodot_dot32_scaled(c10, h1l, h1m, b0.val[2], b0.val[3], sb[2*j + 1]);
+            c01 = ggml_nodot_dot32_scaled(c01, h0l, h0m, b1.val[2], b1.val[3], sa[2*j + 1]);
+            c11 = ggml_nodot_dot32_scaled(c11, h1l, h1m, b1.val[2], b1.val[3], sb[2*j + 1]);
+        }
+        const float da = GGML_CPU_FP16_TO_FP32(x0[i].d), db = GGML_CPU_FP16_TO_FP32(x1[i].d);
+        const float ma = GGML_CPU_FP16_TO_FP32(x0[i].dmin), mb = GGML_CPU_FP16_TO_FP32(x1[i].dmin);
+        // [x0.y0, x1.y0, x0.y1, x1.y1]
+        const int32x4_t isum = vpaddq_s32(vpaddq_s32(c00, c10), vpaddq_s32(c01, c11));
+        const int32x4_t imin = vpaddq_s32(vpaddq_s32(m00, m10), vpaddq_s32(m01, m11));
+        const float32x4_t dd = { da * y0[i].d, db * y0[i].d, da * y1[i].d, db * y1[i].d };
+        const float32x4_t dm = { ma * y0[i].d, mb * y0[i].d, ma * y1[i].d, mb * y1[i].d };
+        r = vfmaq_f32(r, vcvtq_f32_s32(isum), dd);
+        r = vfmsq_f32(r, vcvtq_f32_s32(imin), dm);
+    }
+    vst1_f32(s,      vget_low_f32(r));
+    vst1_f32(s + bs, vget_high_f32(r));
+}
